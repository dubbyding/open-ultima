# ============================================================================
# Open Ultima — environment configuration
# ============================================================================
# Copy to .env. Everything is optional: with no .env the app runs fully
# offline over Bluetooth, and workout maps use OpenStreetMap (no key).
#
# (rebuild) = baked into the native app; run `npx expo run:android` after changing.
# Others are read by the JS bundle; restart Metro with `npx expo start -c`.
# ============================================================================

# --- Workout maps ------------------------------------------------------------
# "osm"    OpenStreetMap on Android and iPhone. Free, no key. (default)
# "google" Google Maps on Android (needs the key below); Apple Maps on iPhone.
EXPO_PUBLIC_MAP_PROVIDER=osm

# Google Maps key (rebuild). Android only, used when EXPO_PUBLIC_MAP_PROVIDER=google.
# Google Cloud > Maps SDK for Android > API key restricted to Android apps:
#   package com.nhumark.openultima + your signing SHA-1.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional custom OSM-style raster tile server, {z}/{x}/{y} template.
# Default: https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_OSM_TILE_URL=

# --- Google Sheets export ----------------------------------------------------
# Android needs nothing here: create an "Android" OAuth client in Google Cloud
# with package com.nhumark.openultima + your SHA-1 and enable the Sheets API.
# iPhone (rebuild): client ID of an "iOS" OAuth client for bundle ID
# com.nhumark.openultima, e.g. 1234-abc.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- Strava (parked: Strava's API now needs a paid subscription) --------------
# API app at https://www.strava.com/settings/api, callback domain "localhost".
EXPO_PUBLIC_STRAVA_CLIENT_ID=
EXPO_PUBLIC_STRAVA_CLIENT_SECRET=

# --- Developer -----------------------------------------------------------------
# TX/RX frames kept in the Packet Inspector.
EXPO_PUBLIC_PACKET_LOG_LIMIT=250
# AsyncStorage key used by OfflineStore.
EXPO_PUBLIC_STORAGE_KEY=ultima_open_offline_state_v1
