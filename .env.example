# ============================================================================
# Ultima Open — Environment Configuration (.env.example)
# ============================================================================
# NOTE: You do NOT need a .env file or any API keys to build or run Ultima Open!
#
# Unlike the original Ultima Link (YSAppSDK cloud license check) and ULTIMA Fit
# (Baidu Maps / AdMob / Pangle / MBridge / Meta SDKs), Ultima Open runs 100%
# offline on-device over Bluetooth LE with zero external servers or API keys.
#
# All variables below are completely OPTIONAL local overrides for development.
# ============================================================================

# Default connection mode on app launch: "simulator" or "live_ble"
EXPO_PUBLIC_DEFAULT_BLE_MODE=simulator

# Maximum number of TX/RX hex frames kept in the live Packet Inspector ring buffer
EXPO_PUBLIC_PACKET_LOG_LIMIT=250

# Local AsyncStorage key used by OfflineStore
EXPO_PUBLIC_STORAGE_KEY=ultima_open_offline_state_v1

# Optional default reference coordinates for the Hardware Simulator offline map
# (Defaults to Kathmandu, Nepal: 27.7172, 85.3240 when unset)
EXPO_PUBLIC_SIM_DEFAULT_LAT=27.7172
EXPO_PUBLIC_SIM_DEFAULT_LNG=85.3240
